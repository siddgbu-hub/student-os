{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "student-os-backend",
	"main": "src/index.ts",
	"compatibility_date": "2026-02-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {
		"ENVIRONMENT": "production",
		"ALLOWED_ORIGIN": "https://student-os-19f.pages.dev",
		"BREVO_FROM_EMAIL": "studentos.apk@gmail.com",
		"BREVO_FROM_NAME": "Student OS",
		"GOOGLE_CLIENT_ID": "272183133963-1scshesrdvt7s6ke9g0rco15rapack7t.apps.googleusercontent.com"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "student-os-db",
			"database_id": "ba828b17-5c24-4303-9c31-1375a123361f",
			"migrations_dir": "../database/migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "student-os-storage"
		}
	],
	"env": {
		"production": {
			"vars": {
				"ENVIRONMENT": "production",
				"ALLOWED_ORIGIN": "https://student-os-19f.pages.dev",
				"BREVO_FROM_EMAIL": "studentos.apk@gmail.com",
				"BREVO_FROM_NAME": "Student OS",
				"GOOGLE_CLIENT_ID": "272183133963-1scshesrdvt7s6ke9g0rco15rapack7t.apps.googleusercontent.com"
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "student-os-db",
					"database_id": "ba828b17-5c24-4303-9c31-1375a123361f",
					"migrations_dir": "../database/migrations"
				}
			],
			"r2_buckets": [
				{
					"binding": "BUCKET",
					"bucket_name": "student-os-storage"
				}
			]
		}
	},
	"dev": {
		"port": 8789
	}
}
