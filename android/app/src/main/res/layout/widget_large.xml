<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_large_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#18181B"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Student OS — Hero Study Controller"
            android:textColor="#3B82F6"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔥 Active Streak"
            android:textColor="#F59E0B"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_subject_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Organic Chemistry"
        android:textColor="#FAFAFA"
        android:textSize="15sp"
        android:textStyle="bold"
        android:layout_marginTop="6dp" />

    <TextView
        android:id="@+id/widget_study_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="21m / 120m Studied Today"
        android:textColor="#FAFAFA"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="4dp" />

    <Chronometer
        android:id="@+id/widget_chronometer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FAFAFA"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="4dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_remaining_goal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Remaining Goal: 99 minutes"
        android:textColor="#93C5FD"
        android:textSize="13sp"
        android:layout_marginTop="2dp" />

    <Chronometer
        android:id="@+id/widget_countdown_chronometer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#93C5FD"
        android:textSize="13sp"
        android:layout_marginTop="2dp"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#3F3F46"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/widget_pending_summary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pending Tasks: 3 • Due Revision: 1"
        android:textColor="#FAFAFA"
        android:textSize="12sp"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Action Controls -->
    <TextView
        android:id="@+id/widget_btn_start"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:background="#2563EB"
        android:text="▶ Start Focused Study Session"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:gravity="center"
        android:visibility="visible" />

    <LinearLayout
        android:id="@+id/widget_active_controls"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_btn_pause"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#D97706"
            android:text="⏸ Pause Session"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginEnd="6dp"
            android:visibility="visible" />

        <TextView
            android:id="@+id/widget_btn_resume"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#2563EB"
            android:text="▶ Resume Session"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginEnd="6dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_btn_complete"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#059669"
            android:text="✓ Complete Session"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center" />
    </LinearLayout>

</LinearLayout>
